{
  "name": "@fastpdf/core",
  "version": "0.3.0-alpha",
  "description": "FastPDF WASM core — framework-agnostic PDF engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build": "npm run build:wasm && tsc",
    "build:wasm": "wasm-pack build ../../crates/fastpdf-wasm --target bundler --out-dir ../../packages/core/pkg --out-name fastpdf",
    "test": "node --test dist/test/smoke.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3"
  }
}
